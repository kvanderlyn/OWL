{
    "linter": {
        "enabled": true,
        "domains": {
            "drizzle": "recommended",
            "react": "recommended",
            "turborepo": "recommended"
        },
        "rules": {
            "recommended": true
        },
        "includes": [
            "**",
            "!test/**"
        ]
    },
    "formatter": {
        "lineWidth": 120,
        "indentStyle": "space",
        "indentWidth": 6
    },
    "files": {
        "includes": [
            "src/**/*.js",
            "test/**/*.js",
            "!**/*.min.js"
        ]
    }
}